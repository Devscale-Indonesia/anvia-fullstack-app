# Copy this file to .env and fill in your own values. Never commit .env.

# LLM provider (https://openrouter.ai)
OPENROUTER_API_KEY=

# Web search and page reading tools (https://tavily.com)
TAVILY_API_KEY=

# Anvia Lens tracing and eval reports
ANVIA_LENS_BASE_URL=
ANVIA_LENS_PUBLIC_KEY=
ANVIA_LENS_SECRET_KEY=

# Postgres from docker-compose.dev.yaml (host port 5433)
DATABASE_URL=postgresql://anvia:anvia@localhost:5433/anvia

# Anthropic API key, only needed to pick the Claude model in the chat (https://console.anthropic.com)
ANTHROPIC_API_KEY=
